FROM mcr.microsoft.com/devcontainers/base:trixie

ENV DEBIAN_FRONTEND=noninteractive

# Debian packaging toolchain (matches Dockerfile.build) plus general dev tools.
# Trixie ships Python 3.13 natively, same as the package build target.
RUN apt-get update && apt-get install --yes --no-install-recommends \
    apt-transport-https ca-certificates sudo git ssh build-essential \
    debhelper dh-python dh-virtualenv devscripts equivs pkg-config \
    python3 python3-dev python3-setuptools python3-venv \
    unzip zip nload tree vlan

# Install the package build dependencies from debian/control so the same
# environment that builds the .deb is available for development. Requires
# the devcontainer build context to be the repo root (see devcontainer.json).
COPY debian/control /tmp/build-deps/debian/control
RUN apt-get update \
    && mk-build-deps --install --remove \
       --tool "apt-get -y --no-install-recommends" /tmp/build-deps/debian/control \
    && rm -rf /tmp/build-deps

RUN apt-get update \
&& apt-get install --no-install-recommends --yes rsyslog systemd systemd-cron \
# Fix a bug with common-debian script
&& rm -f /usr/local/bin/systemctl \
#  Clean up
&& apt-get clean && rm -rf /var/lib/apt/lists/*

CMD ["/lib/systemd/systemd", "--system", "--unit=basic.target"]
